{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pirc.example/schemas/v1/economic-settlement-request.schema.json",
  "title": "Economic Settlement Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "period_id",
    "expected_contract_id",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "period_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "expected_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    }
  }
}
