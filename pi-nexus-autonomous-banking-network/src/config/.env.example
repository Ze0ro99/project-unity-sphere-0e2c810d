# Safe template only. Copy to a local .env file and set real values outside Git.
# Never commit populated environment files or private credentials.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=replace-with-local-value
DB_PASSWORD=replace-with-secret-from-secret-manager
DB_NAME=mydatabase
API_KEY=replace-with-secret-from-secret-manager
LOG_LEVEL=info
LOG_FILE=replace-with-local-value
ENABLE_FEATURE_X=replace-with-local-value
