# Safe template only. Copy to a local .env file and set real values outside Git.
# Never commit populated environment files or private credentials.
VITE_SUPABASE_PROJECT_ID=iirymtunobrpjlxxnuad
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
VITE_SUPABASE_URL=https://iirymtunobrpjlxxnuad.supabase.co

# Server-only Pi Testnet1 profile. Do not prefix these values with VITE_.
# Testnet1 is this project's alias for the Pi Testnet network.
PI_NETWORK=testnet
PI_HORIZON_URL=https://api.testnet.minepi.com
PI_SOROBAN_RPC_URL=https://rpc.testnet.minepi.com
PI_NETWORK_PASSPHRASE=replace-with-the-verified-live-pi-testnet-passphrase
PI_PROTOCOL_EXPECTED=28
PI_TESTNET_ALLOWED_HOSTS=api.testnet.minepi.com,rpc.testnet.minepi.com
PI_TESTNET_HTTP_TIMEOUT_SECONDS=5

# Leave signing disabled until an isolated Testnet-only signer is configured.
PI_SIGNER_PROVIDER=disabled
PI_SIGNER_CREDENTIAL_REF=
PI_DEPLOYMENT_ALLOWLIST=
